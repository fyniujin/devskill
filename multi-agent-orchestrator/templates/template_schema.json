{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline Template Metadata Schema",
  "description": "预置流水线模板元数据规范，用于声明模板依赖的外部 skill 和分类信息",
  "type": "object",
  "required": ["name", "description", "category", "version"],
  "properties": {
    "name": {
      "type": "string",
      "description": "模板显示名称"
    },
    "description": {
      "type": "string",
      "description": "模板功能描述"
    },
    "category": {
      "type": "string",
      "enum": ["data-processing", "content-generation", "monitoring", "analysis"],
      "description": "模板分类"
    },
    "version": {
      "type": "string",
      "description": "模板版本号"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "标签列表"
    },
    "dependencies": {
      "type": "array",
      "description": "建议安装的外部 skill 列表（仅提示，不自动安装）",
      "items": {
        "type": "object",
        "required": ["skill_id", "install_link", "description"],
        "properties": {
          "skill_id": {
            "type": "string",
            "description": "skill 的唯一标识"
          },
          "install_link": {
            "type": "string",
            "description": "安装链接（SkillHub 或 ClawHub）"
          },
          "description": {
            "type": "string",
            "description": "该 skill 的用途说明"
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "是否必需（true=缺失则对应节点标灰）"
          }
        }
      }
    }
  }
}
