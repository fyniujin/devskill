{
  "name": "知识库周更",
  "description": "知识库内容周更：扫描指定信息源 → 提取新增/变更内容 → 分类整理 → 更新知识库条目 → 生成变更日志。适用于团队知识库维护、竞品知识库更新、行业动态追踪。",
  "category": "content-generation",
  "version": "1.0",
  "tags": ["知识库", "周更", "信息聚合", "内容维护"],
  "three_elements": {
    "time_estimate": "10-20 分钟（取决于信息源数量）",
    "api_key_required": "可选",
    "output_files": ["knowledge_base_update.md", "changelog.md", "knowledge_base_state.json"]
  },
  "dependencies": [
    {
      "skill_id": "tencent-docs",
      "install_link": "https://skillhub.cn/skill/tencent-docs",
      "description": "腾讯文档（用于知识库协作编辑）",
      "required": false
    },
    {
      "skill_id": "notion",
      "install_link": "https://skillhub.cn/skill/notion",
      "description": "Notion（用于知识库条目管理）",
      "required": false
    }
  ],
  "pipeline": {
    "pipeline_name": "知识库周更",
    "version": "1.0",
    "description": "知识库内容周更与变更日志生成",
    "agents": [
      {
        "id": "source_scanner",
        "name": "信息源扫描Agent",
        "role": "扫描配置的信息源（RSS/网站/API），获取本周新增/变更内容",
        "type": "task",
        "inputs": ["source_config"],
        "outputs": ["raw_updates"],
        "depends_on": [],
        "retry": 3,
        "timeout": 120,
        "fallback": "default",
        "default_value": {"raw_updates": []}
      },
      {
        "id": "diff_detector",
        "name": "变更检测Agent",
        "role": "与上周知识库快照对比，识别新增条目、更新条目、删除条目",
        "type": "task",
        "inputs": ["raw_updates"],
        "outputs": ["diff_result"],
        "depends_on": ["source_scanner"],
        "retry": 2,
        "timeout": 60,
        "fallback": "default",
        "default_value": {"diff_result": {"added": [], "updated": [], "deleted": []}}
      },
      {
        "id": "content_categorizer",
        "name": "内容分类Agent",
        "role": "按知识库分类体系（产品/技术/运营/行业）自动归类变更内容",
        "type": "task",
        "inputs": ["diff_result"],
        "outputs": ["categorized_updates"],
        "depends_on": ["diff_detector"],
        "retry": 2,
        "timeout": 60,
        "fallback": "default",
        "default_value": {"categorized_updates": {}}
      },
      {
        "id": "quality_checker",
        "name": "质量检查Agent",
        "role": "检查新增内容质量：完整性、准确性、重复性、格式规范",
        "type": "task",
        "inputs": ["categorized_updates"],
        "outputs": ["quality_report"],
        "depends_on": ["content_categorizer"],
        "retry": 2,
        "timeout": 60,
        "fallback": "default",
        "default_value": {"quality_report": {}}
      },
      {
        "id": "approver",
        "name": "知识库审核",
        "role": "知识库管理员审核变更内容，确认入库或标记需修改",
        "type": "approval",
        "inputs": ["categorized_updates", "quality_report"],
        "outputs": ["approved_updates"],
        "depends_on": ["quality_checker"],
        "retry": 0,
        "timeout": 0,
        "fallback": "abort",
        "timeout_seconds": 600,
        "timeout_action": "reject"
      },
      {
        "id": "kb_updater",
        "name": "知识库更新Agent",
        "role": "将审核通过的变更写入知识库，更新索引和关联关系",
        "type": "task",
        "inputs": ["approved_updates"],
        "outputs": ["update_result"],
        "depends_on": ["approver"],
        "retry": 2,
        "timeout": 120,
        "fallback": "abort"
      },
      {
        "id": "reporter",
        "name": "变更日志Agent",
        "role": "生成本周知识库变更日志：新增/更新/删除条目清单、质量评分、下周建议",
        "type": "task",
        "inputs": ["update_result", "quality_report"],
        "outputs": ["changelog"],
        "depends_on": ["kb_updater"],
        "retry": 1,
        "timeout": 60,
        "fallback": "abort"
      }
    ],
    "state_store": {
      "type": "json",
      "path": "./knowledge_base_state.json"
    }
  }
}
